{
  "auto_correct_locator": false,
  "headless": true,
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
  "pbkdf2_iterations": 200000,
  "waits": {
    "absolute_seconds": 5,
    "random_min_seconds": 15,
    "random_max_seconds": 30,
    "short_random_min_seconds": 6,
    "short_random_max_seconds": 12
  },
  "screenshot": {
    "dir": "error",
    "filename": "error_screenshot.png",
    "full_page": true
  },
  "onlyfiles": {
    "upload_url": "https://api.onlyfiles.com/v1/upload",
    "expire_seconds": 172800,
    "enabled": true
  },
  "gemini": {
    "api_key_env": "GEMINI_API_KEY",
    "model": "gemini-3.5-flash-lite"
  },
  "env": {
    "decrypt_key": "DECRYPT_KEY"
  },
  "cookie_dirs": {
    "chatgpt": "chatgpt_cookies",
    "grok": "grok_cookies"
  },
  "platforms": {
    "chatgpt": {
      "no_viewport": true,
      "launch_args": [
        "--start-maximized",
        "--disable-blink-features=AutomationControlled"
      ]
    },
    "grok": {
      "no_viewport": true,
      "scroll_down_presses": 15,
      "launch_args": [
        "--start-maximized",
        "--disable-blink-features=AutomationControlled"
      ]
    }
  }
}